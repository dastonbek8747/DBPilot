# --- DBPilot backend ---
# PostgreSQL used by the agent for its LangGraph checkpoint memory
DB_URL_AGENT=postgresql://postgres:postgres@localhost:5432/dbpilot

# JWT signing key for the login cookie (generate a random 64-char string)
SECRET_KEY=change_me_to_a_long_random_string

# --- LLM providers (at least one is required) ---
GEMINI_API_KEY1=your_gemini_api_key_here
GEMINI_API_KEY2=your_gemini_api_key_here
GROQ_API_KEY1=your_groq_api_key_here
OPENROUTER_API_KEY1=your_openrouter_api_key_here
OPENROUTER_API_KEY2=your_openrouter_api_key_here

# Ollama (local, optional) - default endpoint
OLLAMA_HOST=http://localhost:11434
